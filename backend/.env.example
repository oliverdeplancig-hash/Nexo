# Copie para .env e ajuste. NUNCA versione o arquivo .env.

NEXO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
NEXO_DEBUG=true
NEXO_ALLOWED_HOSTS=localhost,127.0.0.1
NEXO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NEXO_COOKIE_SEGURO=false

# PostgreSQL 15+ com as extensões vector (pgvector) e unaccent disponíveis
NEXO_DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo

# Diretório protegido dos arquivos (fora da raiz web)
NEXO_ARMAZENAMENTO_DIR=./armazenamento
NEXO_UPLOAD_MAX_MB=50
# true = processa o upload na hora (instalação local); false = worker processar_fila
NEXO_PROCESSAR_IMEDIATAMENTE=true

# IA local (Ollama). Use "falso" para demonstrar sem LLM.
NEXO_IA_PROVEDOR=ollama
NEXO_OLLAMA_URL=http://localhost:11434
NEXO_MODELO_CHAT=qwen2.5:7b-instruct
NEXO_MODELO_EMBEDDING=bge-m3
NEXO_DIMENSAO_EMBEDDING=1024
NEXO_SIMILARIDADE_MINIMA=0.45

# Motor determinístico
NEXO_MOTOR_LIMIAR=0.62
NEXO_MOTOR_MARGEM=0.04

# Vários processos (servidor): defina para ativar o channel layer Redis
# NEXO_REDIS_URL=redis://localhost:6379/0

# OCR de documentos digitalizados (Tesseract com idioma português). "desligado" para não usar.
NEXO_OCR_MOTOR=tesseract
# NEXO_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# NEXO_TESSDATA_DIR=./.tessdata

# Login institucional pela conta Microsoft (Entra ID) — ADR-010 e docs/security/login-microsoft.md.
# Deixe em branco para não mostrar o botão. O segredo NUNCA vai para o Git.
NEXO_ENTRA_TENANT_ID=
NEXO_ENTRA_CLIENT_ID=
NEXO_ENTRA_CLIENT_SECRET=
NEXO_ENTRA_DOMINIOS=pm.ba.gov.br
NEXO_ENTRA_CRIAR_USUARIOS=true
NEXO_ENTRA_PERFIL_PADRAO=servidor
# Vazio = http(s)://<endereço do Nexo>/api/v1/auth/microsoft/retorno/
# NEXO_ENTRA_REDIRECT_URI=https://nexo.exemplo/api/v1/auth/microsoft/retorno/
# false = só login institucional (contas locais deixam de entrar pela tela)
NEXO_LOGIN_LOCAL=true

# Revisão periódica de documentos (ADR-015): aviso N dias antes e repetição enquanto atrasada
NEXO_REVISAO_ANTECEDENCIA_DIAS=30
NEXO_REVISAO_REPETIR_DIAS=7

# Cópias de segurança (banco + arquivos) — docs/architecture/copia-de-seguranca.md
# Pasta das cópias. No servidor: /var/lib/nexo/copias (e leve cópias para fora do servidor!)
NEXO_BACKUP_DIR=./copias
# Senha que cifra as cópias. Guarde-a FORA do servidor: sem ela nenhuma cópia abre.
NEXO_BACKUP_SENHA=
# Quantas cópias diárias manter
NEXO_BACKUP_RETENCAO=14
# Pasta do pg_dump/pg_restore/psql, se não estiverem no PATH (ex.: /usr/lib/postgresql/15/bin)
# NEXO_PG_BIN=

# E-mail (ADR-018): envio de usuário e senha temporária no cadastro. Use o SMTP da instituição.
# Sem NEXO_EMAIL_HOST nada é enviado e a senha aparece só para quem cadastrou.
# NEXO_EMAIL_HOST=smtp.instituicao.exemplo
# NEXO_EMAIL_PORTA=587
# NEXO_EMAIL_USUARIO=
# NEXO_EMAIL_SENHA=
# NEXO_EMAIL_TLS=true
# NEXO_EMAIL_REMETENTE=nexo@instituicao.exemplo
# Endereço do Nexo que vai no e-mail
# NEXO_URL_PUBLICA=https://nexo.instituicao.exemplo
# Validade da senha temporária, em horas
NEXO_SENHA_TEMPORARIA_HORAS=72

# Servidor de rede no Windows (ADR-019): o instalador scripts\instalar-servidor-windows.cmd grava estes valores.
# NEXO_SERVIR_FRONTEND=true        # o próprio Nexo entrega as telas (frontend/dist) no mesmo endereço
# NEXO_REDIRECIONAR_HTTPS=true     # HTTP só redireciona para HTTPS
# NEXO_PORTA_HTTPS=443
# NEXO_PORTA_HTTP=80
# Atrás do nginx ou de outro proxy reverso (servidor Linux, nuvem): confia no X-Forwarded-Proto do proxy.
# NEXO_ATRAS_DE_PROXY=true

# Capacidade (ADR-020) — ver docs/architecture/capacidade.md
# Conexões do banco compartilhadas por processo web (0 = desligado; servidor: 40)
# NEXO_DB_POOL_MAXIMO=40
# NEXO_DB_POOL_ESPERA=30
# Gerações simultâneas da IA por processo, perguntas que podem esperar e espera máxima (segundos).
# Acima disso a pergunta é respondida na hora com os trechos encontrados.
# NEXO_IA_CONCORRENCIA=2
# NEXO_IA_FILA_MAXIMA=50
# NEXO_IA_ESPERA_MAXIMA=45

# Memória da conversa (ADR-021): mensagens que vão literais à IA; as anteriores viram resumo.
# NEXO_MEMORIA_JANELA=6
# NEXO_MEMORIA_MAXIMO_ITENS=12
