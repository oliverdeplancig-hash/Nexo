[Unit]
Description=Nexo — worker de ingestão de documentos
After=network.target postgresql.service

[Service]
User=nexo
Group=nexo
WorkingDirectory=/opt/nexo/backend
EnvironmentFile=/opt/nexo/backend/.env
ExecStart=/opt/nexo/backend/.venv/bin/python manage.py processar_fila --continuo
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/nexo

[Install]
WantedBy=multi-user.target
